# Placeholder only. Keep real values in ~/.agentic-workflows/secrets.env.
# Follow docs/configuration.md#persistent-github-token-on-posix to create the
# private file, then copy this export into it using a trusted local editor.
# Restrict access: chmod 600 ~/.agentic-workflows/secrets.env
# Source the private file from ~/.bashrc and reload it after token changes.
# GH_TOKEN is preferred; GITHUB_TOKEN is used only if GH_TOKEN is unset or empty.
export GH_TOKEN='REPLACE_WITH_YOUR_FINE_GRAINED_TOKEN'
